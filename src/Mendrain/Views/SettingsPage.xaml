<Page
    x:Class="Mendrain.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Mendrain.Helpers"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <!-- Full-width host so the width-limited content below stays centered (ScrollViewer left-aligns its child). -->
      <Grid>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="16">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{StaticResource GlyphTheme}" FontSize="{StaticResource IconSizeL}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="App theme" />
                        <TextBlock Text="Choose light, dark, or follow Windows." Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="2" MinWidth="150" VerticalAlignment="Center" SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Use Windows setting" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{StaticResource GlyphFolderOpen}" FontSize="{StaticResource IconSizeL}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="File Explorer menu" />
                        <TextBlock x:Name="ShellMenuText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="AddShellMenuButton" Click="AddShellMenuButton_Click" />
                        <Button x:Name="RemoveShellMenuButton" Content="Remove" Click="RemoveShellMenuButton_Click"
                                AutomationProperties.Name="Remove from File Explorer menu" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{StaticResource GlyphOpen}" FontSize="{StaticResource IconSizeL}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Default archive app" />
                        <TextBlock x:Name="FileTypesText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Set Mendrain as Default Archive App" Click="SetDefaultButton_Click"
                                AutomationProperties.Name="Set Mendrain as Default Archive App" />
                        <Button x:Name="RemoveFileTypesButton" Content="Remove" Click="RemoveFileTypesButton_Click"
                                AutomationProperties.Name="Remove Mendrain from Open with" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{StaticResource GlyphLock}" FontSize="{StaticResource IconSizeL}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Saved passwords" />
                        <TextBlock x:Name="SavedPasswordsText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="RemovePasswordsButton" Grid.Column="2" Content="Remove all…" VerticalAlignment="Center"
                            Click="RemovePasswordsButton_Click" AutomationProperties.Name="Remove all saved passwords" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <FontIcon Glyph="{StaticResource GlyphUpdate}" FontSize="{StaticResource IconSizeL}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Updates" />
                        <TextBlock Text="{x:Bind Updates.StatusText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing Width="16" Height="16" IsActive="{x:Bind Updates.IsBusy, Mode=OneWay}"
                                      Visibility="{x:Bind h:Format.Show(Updates.IsBusy), Mode=OneWay}" />
                        <Button Content="Check for updates" Command="{x:Bind Updates.CheckCommand}" IsEnabled="{x:Bind Updates.IsIdle, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                        <CheckBox x:Name="PreviewUpdatesBox" Content="Include preview versions" Click="PreviewUpdatesBox_Click"
                                  ToolTipService.ToolTip="Also offer pre-release versions. Off: stable releases only." />
                        <HyperlinkButton Content="Release notes" NavigateUri="https://github.com/esteriavaelis/mendrain/releases" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <FontIcon Glyph="{StaticResource GlyphArchive}" FontSize="{StaticResource IconSizeL}" />
                        <TextBlock Text="Formats and safety" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Extract:</Run>
                        <Run Text=" ZIP (including ZipCrypto and AES encryption), 7Z (including solid and AES-encrypted), RAR 5 (including solid, encrypted and multi-volume .partN.rar sets)." />
                        <LineBreak /><Run FontWeight="SemiBold">Create:</Run>
                        <Run Text=" ZIP." />
                        <LineBreak /><LineBreak />
                        <Run Text="Archives are extracted into a hidden temporary folder next to the destination and moved into place only after every file has been read and checked. Entries that try to leave the destination folder, absolute paths, links and device files are never written. Names Windows cannot use are adjusted and listed in the result. Existing files are never replaced without your confirmation." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Image Source="ms-appx:///Assets/Logo.png" Width="32" Height="32" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mendrain" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock x:Name="CopyrightText" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
</Page>
