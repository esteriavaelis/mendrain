<Page
    x:Class="Mendrain.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mendrain.ViewModels"
    xmlns:h="using:Mendrain.Helpers"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <!-- Full-width host so the width-limited content below stays centered (ScrollViewer left-aligns its child). -->
      <Grid>
        <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Branding -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <Image Source="ms-appx:///Assets/Logo.png" Width="52" Height="52" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Mendrain" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Archive management, made simple." Style="{StaticResource PageSubtitleStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Drop zone -->
            <Grid
                x:Name="DropZone"
                Grid.Row="1"
                MinHeight="260"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop"
                Background="{ThemeResource DropZoneBackgroundBrush}"
                CornerRadius="{StaticResource CardCornerRadius}">
                <Rectangle
                    x:Name="DropOutline"
                    RadiusX="8" RadiusY="8"
                    Stroke="{ThemeResource DropZoneStrokeBrush}"
                    StrokeThickness="1.5"
                    StrokeDashArray="5,4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Padding="24">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{ThemeResource IconTileBackgroundBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="{StaticResource GlyphArchive}" FontSize="{StaticResource IconSizeXL}" Foreground="{ThemeResource IconTileForegroundBrush}" />
                    </Border>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Drop archives here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                        <TextBlock
                            Text="One archive opens it · several start a batch extract · files and folders go into a new ZIP"
                            Style="{StaticResource PageSubtitleStyle}"
                            TextAlignment="Center"
                            MaxWidth="600" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.OpenArchiveCommand}" AutomationProperties.Name="Open archive">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource GlyphOpen}" Style="{StaticResource IconButtonGlyphStyle}" />
                                <TextBlock Text="Open archive" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.GoToCreateZipCommand}" AutomationProperties.Name="Create ZIP">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource GlyphCompress}" Style="{StaticResource IconButtonGlyphStyle}" />
                                <TextBlock Text="Create ZIP" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.GoToBatchCommand}" AutomationProperties.Name="Batch extract">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{StaticResource GlyphBatch}" Style="{StaticResource IconButtonGlyphStyle}" />
                                <TextBlock Text="Batch extract" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="ZIP · 7Z · RAR" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Recent archives -->
            <StackPanel Grid.Row="2" Spacing="8">
                <Grid>
                    <TextBlock Text="Recent archives" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton
                        Content="Clear"
                        HorizontalAlignment="Right"
                        Padding="8,4"
                        Visibility="{x:Bind h:Format.Show(ViewModel.HasRecent), Mode=OneWay}"
                        Command="{x:Bind ViewModel.ClearRecentCommand}" />
                </Grid>

                <Border Style="{StaticResource CardStyle}" Padding="20" Visibility="{x:Bind h:Format.Hide(ViewModel.HasRecent), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="{StaticResource GlyphHistory}" FontSize="{StaticResource IconSizeL}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="Archives you open will appear here." Style="{StaticResource PageSubtitleStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Padding="4" Visibility="{x:Bind h:Format.Show(ViewModel.HasRecent), Mode=OneWay}">
                    <ListView
                        ItemsSource="{x:Bind ViewModel.Recent}"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="Recent_ItemClick"
                        ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentItem">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <FontIcon Glyph="{StaticResource GlyphArchive}" Style="{StaticResource IconTileGlyphStyle}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="2"
                                        Style="{StaticResource SubtleButtonStyle}"
                                        Padding="8"
                                        Click="RemoveRecent_Click"
                                        ToolTipService.ToolTip="Remove from list"
                                        AutomationProperties.Name="Remove from list">
                                        <FontIcon Glyph="{StaticResource GlyphClose}" FontSize="{StaticResource IconSizeS}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>
        </Grid>
      </Grid>
    </ScrollViewer>
</Page>
