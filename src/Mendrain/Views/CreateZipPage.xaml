<Page
    x:Class="Mendrain.Views.CreateZipPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Mendrain.ViewModels"
    xmlns:h="using:Mendrain.Helpers"
    Background="Transparent">

    <Grid MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Create ZIP" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Files are stored at the top of the ZIP; folders keep their name and everything inside them."
                       Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.AddFilesCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="Add files">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource GlyphFile}" Style="{StaticResource IconButtonGlyphStyle}" />
                    <TextBlock Text="Add files" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.AddFolderCommand}" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" AutomationProperties.Name="Add folder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource GlyphFolder}" Style="{StaticResource IconButtonGlyphStyle}" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.ClearCommand}" IsEnabled="{x:Bind ViewModel.HasItems, Mode=OneWay}" AutomationProperties.Name="Clear">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{StaticResource GlyphDelete}" Style="{StaticResource IconButtonGlyphStyle}" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Items -->
        <Grid x:Name="ItemsZone" Grid.Row="2" AllowDrop="True" DragOver="Items_DragOver" DragLeave="Items_DragLeave" Drop="Items_Drop"
              Background="Transparent" CornerRadius="{StaticResource CardCornerRadius}">
            <Border Style="{StaticResource CardStyle}" Padding="0" Visibility="{x:Bind h:Format.Show(ViewModel.HasItems), Mode=OneWay}">
                <ListView Padding="0,4" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None"
                          ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceItem">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTileStyle}">
                                    <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource IconTileGlyphStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" Padding="8" Click="RemoveItem_Click"
                                        ToolTipService.ToolTip="Remove" AutomationProperties.Name="Remove">
                                    <FontIcon Glyph="{StaticResource GlyphClose}" FontSize="{StaticResource IconSizeS}" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Grid Visibility="{x:Bind h:Format.Hide(ViewModel.HasItems), Mode=OneWay}" Background="{ThemeResource DropZoneBackgroundBrush}"
                  CornerRadius="{StaticResource CardCornerRadius}">
                <Rectangle RadiusX="8" RadiusY="8" Stroke="{ThemeResource DropZoneStrokeBrush}" StrokeThickness="1.5" StrokeDashArray="5,4" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{ThemeResource IconTileBackgroundBrush}" HorizontalAlignment="Center">
                        <FontIcon Glyph="{StaticResource GlyphCompress}" FontSize="24" Foreground="{ThemeResource IconTileForegroundBrush}" />
                    </Border>
                    <TextBlock Text="Drop files and folders here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock Text="or use Add files and Add folder." Style="{StaticResource PageSubtitleStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <InfoBar Grid.Row="3"
                 IsOpen="{x:Bind ViewModel.IsResultOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.ResultSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.ResultTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.ResultMessage, Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button Content="Show in folder" Command="{x:Bind ViewModel.ShowOutputCommand}"
                        Visibility="{x:Bind h:Format.Show(ViewModel.CanShowResult), Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Output options -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Header="ZIP name" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                         Text="{x:Bind ViewModel.ZipName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Archive.zip" />
                <Grid Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Header="Save in" Text="{x:Bind ViewModel.SaveFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseSaveFolderCommand}"
                            ToolTipService.ToolTip="Choose folder" AutomationProperties.Name="Choose folder">
                        <FontIcon Glyph="{StaticResource GlyphFolderOpen}" Style="{StaticResource IconButtonGlyphStyle}" />
                    </Button>
                </Grid>
                <ComboBox Grid.Column="2" Header="Compression" MinWidth="130" IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                          ItemsSource="{x:Bind ViewModel.Levels}" SelectedItem="{x:Bind ViewModel.SelectedLevel, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CompressionOption">
                            <TextBlock Text="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Description}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Grid.Column="3" VerticalAlignment="Bottom" MinWidth="130" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.CreateCommand}" IsEnabled="{x:Bind ViewModel.CanCreate, Mode=OneWay}"
                        Visibility="{x:Bind h:Format.Show(ViewModel.IsIdle), Mode=OneWay}" AutomationProperties.Name="Create ZIP">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="{StaticResource GlyphCompress}" Style="{StaticResource IconButtonGlyphStyle}" />
                        <TextBlock Text="Create ZIP" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" VerticalAlignment="Bottom" MinWidth="130" Content="Cancel" Command="{x:Bind ViewModel.CancelCommand}"
                        Visibility="{x:Bind h:Format.Show(ViewModel.IsBusy), Mode=OneWay}" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Spacing="6" Visibility="{x:Bind h:Format.Show(ViewModel.IsBusy), Mode=OneWay}">
                    <ProgressBar Value="{x:Bind ViewModel.ProgressValue, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
