<ContentDialog
    x:Class="Mendrain.Views.PasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mendrain.Views"
    Title="Enter password"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False">

    <StackPanel MinWidth="340" MaxWidth="440" Spacing="{StaticResource SpaceS}">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Margin="0,4,0,0" />

        <!-- One field: the password, the show/hide button and the saved-passwords arrow share the same box. -->
        <Grid x:Name="PasswordField" Margin="0,8,0,0">
            <PasswordBox
                x:Name="PasswordInput"
                PlaceholderText="Enter password…"
                PasswordRevealMode="Hidden"
                Padding="10,5,70,6"
                AutomationProperties.Name="Password"
                PasswordChanged="PasswordInput_PasswordChanged"
                KeyDown="PasswordInput_KeyDown" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0" Spacing="2">
                <Button x:Name="RevealButton" Style="{StaticResource InputAdornmentButtonStyle}" Click="RevealButton_Click"
                        AutomationProperties.Name="Show password" ToolTipService.ToolTip="Show password">
                    <!-- Segoe MDL2 on Windows 10 has no "hide" eye, so the revealed state draws a slash over the eye. -->
                    <Grid Width="16" Height="16">
                        <FontIcon Glyph="{StaticResource GlyphShow}" FontSize="{StaticResource IconSizeS}" />
                        <Line x:Name="RevealSlash" X1="2" Y1="2" X2="14" Y2="14" StrokeThickness="1.3" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                              Stroke="{ThemeResource ButtonForeground}" Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="SavedButton" Style="{StaticResource InputAdornmentButtonStyle}" Click="SavedButton_Click"
                        AutomationProperties.Name="Saved passwords" ToolTipService.ToolTip="Saved passwords">
                    <FontIcon Glyph="{StaticResource GlyphChevronDown}" FontSize="12" />
                </Button>
            </StackPanel>

            <FlyoutBase.AttachedFlyout>
                <Flyout x:Name="SavedFlyout" Placement="BottomEdgeAlignedLeft" Opened="SavedFlyout_Opened">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="MaxWidth" Value="640" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <ListView
                        x:Name="SavedList"
                        MaxHeight="260"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="SavedList_ItemClick"
                        KeyDown="SavedList_KeyDown"
                        AutomationProperties.Name="Saved passwords"
                        ItemContainerStyle="{StaticResource StretchListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:SavedPasswordRow">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{StaticResource GlyphLock}" FontSize="{StaticResource IconSizeS}" VerticalAlignment="Center"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Entry.Label}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource InputAdornmentButtonStyle}" Click="RemoveSaved_Click"
                                            AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="Remove saved password">
                                        <FontIcon Glyph="{StaticResource GlyphDelete}" FontSize="{StaticResource IconSizeS}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Flyout>
            </FlyoutBase.AttachedFlyout>
        </Grid>

        <CheckBox x:Name="SaveCheck" Content="Save password"
                  ToolTipService.ToolTip="Saved only after the password works. Stored encrypted for your Windows account." />
        <TextBlock x:Name="SavedNoteText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
